# ==============================================================================
# Volt Enterprise AI/ML & Data Platform Environment Configuration
# ==============================================================================

# General Platform Settings
PROJECT_NAME=Volt
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (PostgreSQL / Async SQLAlchemy)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=volt_admin
POSTGRES_PASSWORD=volt_secure_password
POSTGRES_DB=volt_db
DATABASE_URL=postgresql+asyncpg://volt_admin:volt_secure_password@localhost:5432/volt_db

# Redis & Caching / Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Data Lakehouse & Storage Configuration
DATA_LAKE_PATH=./data/lakehouse
OFFLINE_FEATURE_STORE_PATH=./data/feature_store
DUCKDB_PATH=./data/duckdb/volt_analytics.duckdb
MODEL_VAULT_PATH=./data/model_vault

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# LLM & OpenAI / Anthropic Integration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_LLM_MODEL=gpt-4o-mini

# Observability & Metrics
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
DRIFT_DETECTION_INTERVAL_HOURS=6
DRIFT_PSI_THRESHOLD=0.25
DRIFT_KS_PVALUE_THRESHOLD=0.05

# CORS Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
